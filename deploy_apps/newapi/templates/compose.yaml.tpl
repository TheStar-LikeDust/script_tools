# Generated by cli.sh init/start/update. Edit this template for persistent changes.
services:
  newapi:
    image: "${IMAGE:-calciumion/new-api:latest}"
    container_name: "${INSTANCE_NAME:?INSTANCE_NAME is required}"
    restart: unless-stopped
    environment:
      SQL_DSN: "${SQL_DSN:-}"
      REDIS_CONN_STRING: "${REDIS_CONN_STRING:-}"
      CRYPTO_SECRET: "${CRYPTO_SECRET:-}"
      TZ: "${TZ:-Asia/Shanghai}"
      ERROR_LOG_ENABLED: "${ERROR_LOG_ENABLED:-true}"
    volumes:
      - "./data/${INSTANCE_NAME}_data:/data"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:3000/api/status >/dev/null || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
