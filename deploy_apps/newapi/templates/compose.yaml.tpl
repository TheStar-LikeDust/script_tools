# Generated by cli.sh init/start/update. Edit this template for persistent changes.
services:
  postgres:
    image: "${POSTGRES_IMAGE:-paradedb/paradedb:latest-pg17}"
    container_name: "${INSTANCE_NAME:?INSTANCE_NAME is required}_postgres"
    restart: unless-stopped
    environment:
      POSTGRES_USER: "${DB_USER:?DB_USER is required}"
      POSTGRES_PASSWORD: "${DB_PASSWORD:?DB_PASSWORD is required}"
      POSTGRES_DB: "${DB_NAME:?DB_NAME is required}"
    volumes:
      - "./data/${INSTANCE_NAME}_postgres_data:/var/lib/postgresql/data"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -h 127.0.0.1 -U \"$$POSTGRES_USER\" -d \"$$POSTGRES_DB\""]
      interval: 5s
      timeout: 5s
      retries: 5
      start_period: 60s
  redis:
    image: "${REDIS_IMAGE:-redis:7-alpine}"
    container_name: "${INSTANCE_NAME:?INSTANCE_NAME is required}_redis"
    restart: unless-stopped
    volumes:
      - "./data/${INSTANCE_NAME}_redis_data:/data"
    command: ["redis-server", "--save", "60", "1000", "--appendonly", "yes"]
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 5
  newapi:
    image: "${IMAGE:-calciumion/new-api:latest}"
    container_name: "${INSTANCE_NAME:?INSTANCE_NAME is required}"
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
      redis:
        condition: service_healthy
    environment:
      SQL_DSN: "${SQL_DSN:-}"
      REDIS_CONN_STRING: "${REDIS_CONN_STRING:-}"
      CRYPTO_SECRET: "${CRYPTO_SECRET:-}"
      TZ: "${TZ:-Asia/Shanghai}"
      ERROR_LOG_ENABLED: "${ERROR_LOG_ENABLED:-true}"
    volumes:
      - "./data/${INSTANCE_NAME}_data:/data"
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:3000/api/status >/dev/null || exit 1"]
      interval: 30s
      timeout: 10s
      retries: 3
