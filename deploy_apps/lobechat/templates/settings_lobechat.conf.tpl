# LobeHub stack settings. PostgreSQL, Redis and RustFS belong to this instance.
INSTANCE_NAME="{{INSTANCE_NAME}}"
LOBECHAT_PORT="{{LOBECHAT_PORT}}"
IMAGE="lobehub/lobehub:latest"
POSTGRES_IMAGE="paradedb/paradedb:latest-pg17"
REDIS_IMAGE="redis:7-alpine"
RUSTFS_IMAGE="rustfs/rustfs:latest"
RUSTFS_INIT_IMAGE="rustfs/rc:latest"

# Existing shared Docker network, or empty for a private Compose network.
DOCKER_NETWORK=""

# The bundled PostgreSQL instance creates this database/account on its first start.
# Its port is internal to Docker; no host database port is published.
DB_HOST="{{INSTANCE_NAME}}_postgres"
DB_PORT="5432"
DB_NAME="lobechat"
DB_USER="lobechat"
DB_PASSWORD=''
DB_SSLMODE="disable"

# Required before start: the browser-facing application URL.
APP_URL=""

# Generated once. Keep these with your database backups.
KEY_VAULTS_SECRET='{{KEY_VAULTS_SECRET}}'
AUTH_SECRET='{{AUTH_SECRET}}'
# Generated on the first start, using host Node.js or a one-off app container.
JWKS_KEY=''

# Built-in email/password login, without SMTP or email verification.
# Required before start: a real email or domain allowed to register.
AUTH_ALLOWED_EMAILS=""

# Optional Composio integration.
COMPOSIO_API_KEY=''

# Optional Casdoor OIDC. Leave AUTH_SSO_PROVIDERS empty for email/password only.
AUTH_SSO_PROVIDERS=""
AUTH_CASDOOR_ID=""
AUTH_CASDOOR_SECRET=''
AUTH_CASDOOR_ISSUER=""

# OpenAI or an OpenAI-compatible provider.
ENABLED_OPENAI="1"
OPENAI_API_KEY=''
OPENAI_PROXY_URL="https://api.openai.com/v1"
OPENAI_MODEL_LIST="gpt-4o-mini"

# The bundled Redis instance has no password and publishes no host port.
# Keep the URL database number equal to REDIS_DATABASE.
REDIS_URL='redis://{{INSTANCE_NAME}}_redis:6379/0'
REDIS_DATABASE="0"
REDIS_PREFIX="{{INSTANCE_NAME}}"

# RustFS host ports are generated by init.
RUSTFS_PORT=""
RUSTFS_ADMIN_PORT=""

# Required before start: a browser-accessible URL for the RustFS S3 API port.
# Server-side S3 requests use the internal endpoint on the Compose network.
S3_ENDPOINT=""
S3_INTERNAL_ENDPOINT="http://{{INSTANCE_NAME}}_rustfs:9000"
# The startup helper creates this bucket; these keys also administer this RustFS.
S3_BUCKET="lobechat"
S3_ACCESS_KEY_ID=''
S3_SECRET_ACCESS_KEY=''

# TODO: Configure bucket CORS if browser uploads require it.
