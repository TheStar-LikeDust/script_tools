# Generated by cli.sh init/start/update. Edit this template for persistent changes.
services:
  openwebui:
    image: "${IMAGE:-ghcr.io/open-webui/open-webui:main}"
    container_name: "${INSTANCE_NAME:?INSTANCE_NAME is required}"
    restart: always
    environment:
      WEBUI_SECRET_KEY: "${WEBUI_SECRET_KEY:-}"
      DATABASE_URL: "${DATABASE_URL:-sqlite:////app/backend/data/webui.db}"
      REDIS_URL: "${REDIS_URL:-}"
      STORAGE_PROVIDER: "${STORAGE_PROVIDER:-local}"
      S3_ENDPOINT_URL: "${S3_ENDPOINT_URL:-}"
      S3_ACCESS_KEY_ID: "${S3_ACCESS_KEY_ID:-}"
      S3_SECRET_ACCESS_KEY: "${S3_SECRET_ACCESS_KEY:-}"
      S3_BUCKET_NAME: "${S3_BUCKET_NAME:-}"
      S3_REGION_NAME: "${S3_REGION_NAME:-us-east-1}"
      OLLAMA_BASE_URL: "${OLLAMA_BASE_URL:-}"
      OPENAI_API_BASE_URL: "${OPENAI_API_BASE_URL:-https://api.openai.com/v1}"
      OPENAI_API_KEY: "${OPENAI_API_KEY:-}"
      OPENAI_API_BASE_URLS: "${OPENAI_API_BASE_URLS:-}"
      OPENAI_API_KEYS: "${OPENAI_API_KEYS:-}"
      WEBUI_ADMIN_EMAIL: "${WEBUI_ADMIN_EMAIL:-}"
      WEBUI_ADMIN_PASSWORD: "${WEBUI_ADMIN_PASSWORD:-}"
      WEBUI_ADMIN_NAME: "${WEBUI_ADMIN_NAME:-}"
      HF_TOKEN: "${HF_TOKEN:-}"
      CORS_ALLOW_ORIGIN: "${CORS_ALLOW_ORIGIN:-*}"
      USER_AGENT: "${USER_AGENT:-}"
      ENABLE_PERSISTENT_CONFIG: "${ENABLE_PERSISTENT_CONFIG:-True}"
    volumes:
      - "./data/${INSTANCE_NAME}_data:/app/backend/data"
    extra_hosts:
      - "host.docker.internal:host-gateway"
