# Generated by cli.sh using this app template and ParadeDB's service fragment.
  casdoor:
    image: "${CASDOOR_IMAGE:-casbin/casdoor:latest}"
    container_name: "${CASDOOR_INSTANCE_NAME:?CASDOOR_INSTANCE_NAME is required}"
    restart: unless-stopped
    depends_on:
      postgres:
        condition: service_healthy
    environment:
      RUNNING_IN_DOCKER: "true"
    labels:
      script_tools.app_conf_hash: "${CASDOOR_APP_CONF_HASH:-}"
    ports:
      - "${CASDOOR_PORT:?CASDOOR_PORT is required}:8000"
    volumes:
      - "./data/${CASDOOR_INSTANCE_NAME}_data:/data"
      - "./data/${CASDOOR_INSTANCE_NAME}_config/app.conf:/conf/app.conf:ro"
