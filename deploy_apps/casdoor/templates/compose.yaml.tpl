# Generated by cli.sh init/start/update. Edit this template for persistent changes.
services:
  casdoor:
    image: "${IMAGE:-casbin/casdoor:latest}"
    container_name: "${INSTANCE_NAME}"
    restart: unless-stopped
    environment:
      RUNNING_IN_DOCKER: "true"
    labels:
      script_tools.app_conf_hash: "${APP_CONF_HASH:-}"
    ports:
      - "${CASDOOR_PORT}:8000"
    volumes:
      - "./data/${INSTANCE_NAME}_data:/data"
      - "./data/${INSTANCE_NAME}_config/app.conf:/conf/app.conf:ro"
