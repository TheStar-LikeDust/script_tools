# Generated by cli.sh. Edit this template for persistent changes.
  {{SERVICE_NAME}}:
    image: "${RUSTFS_IMAGE:-rustfs/rustfs:latest}"
    container_name: "${RUSTFS_INSTANCE_NAME:?RUSTFS_INSTANCE_NAME is required}"
    restart: unless-stopped
    environment:
      RUSTFS_CONSOLE_ENABLE: "true"
      RUSTFS_ACCESS_KEY: "${RUSTFS_ACCESS_KEY:?RUSTFS_ACCESS_KEY is required}"
      RUSTFS_SECRET_KEY: "${RUSTFS_SECRET_KEY:?RUSTFS_SECRET_KEY is required}"
    volumes:
      - "./data/${RUSTFS_INSTANCE_NAME}_data:/data"
    command: ["--access-key", "${RUSTFS_ACCESS_KEY}", "--secret-key", "${RUSTFS_SECRET_KEY}", "/data"]
    healthcheck:
      test: ["CMD-SHELL", "wget -qO- http://localhost:9000/health >/dev/null 2>&1 || exit 1"]
      interval: 5s
      timeout: 3s
      retries: 30
